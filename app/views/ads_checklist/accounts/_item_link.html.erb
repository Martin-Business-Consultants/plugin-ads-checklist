<%# locals: (item:, account:, step:, current:) %>
<%# One step in the checklist's list: its number, its state (a dot, or a green check once confirmed). Picking it shows it on the
    right (accounts/_item); replaced by ItemsController#update's turbo stream. %>
<%= link_to ads_checklist_account_path(account, item: item.id), id: dom_id(item, :link), class: class_names("scope-nav__item", "ads-checklist-link--confirmed": item.confirmed?),
      aria: { current: ("page" if current) }, data: { turbo_frame: "ads_checklist", turbo_action: "advance", filter_target: "item" } do %>
  <span class="scope-nav__name">
    <span class="ads-checklist-step txt-x-small txt-subtle"><%= step %></span>
    <%= ad_account_item_marker item %>
    <span class="<%= class_names("overflow-ellipsis", "txt-subtle": item.not_applicable?) %>" title="<%= item.title %>"><%= item.title %></span>
  </span>
<% end %>
