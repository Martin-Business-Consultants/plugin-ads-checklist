<%# locals: (account:, group:, items:) %>
<%# A group's count on its accordion, replaced when one of its items is saved. %>
<span id="<%= dom_id(account, "group_#{group.parameterize(separator: "_")}") %>" class="<%= class_names("txt-x-small", "txt-subtle": !ad_account_group_done?(items), "ads-checklist-group-done": ad_account_group_done?(items)) %>"><% if ad_account_group_done?(items) %><%= icon_tag "check" %> <% end %><%= ad_account_group_summary(items) %></span>
